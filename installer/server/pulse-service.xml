<!--
  WinSW service definition for running Pulse Server as a Windows Service.
  Place this next to pulse-service.exe (a renamed WinSW binary) inside the
  extracted pulse-server folder. Requires Node.js 22.5+ on the machine.
  See install-windows-service.ps1.
-->
<service>
  <id>PulseServer</id>
  <name>Pulse Server</name>
  <description>Pulse activity monitoring sync server and admin dashboard.</description>

  <executable>node</executable>
  <arguments>src\index.js</arguments>
  <workingdirectory>%BASE%</workingdirectory>

  <env name="PULSE_PORT" value="8080" />
  <env name="PULSE_DB" value="%BASE%\data\pulse.db" />
  <env name="PULSE_SESSION_TTL_MIN" value="60" />
  <env name="PULSE_ONLINE_WINDOW_SEC" value="120" />
  <!-- Local timezone for the work-hours analytics filter, e.g. Europe/Budapest. -->
  <env name="TZ" value="UTC" />
  <!-- The update repo is HARDCODED to TMarccci/pulse in the app, so nothing is
       needed here. Only set PULSE_REPO if you run a fork. -->
  <!-- <env name="PULSE_REPO" value="owner/repo" /> -->
  <!-- Create the admin with `node src\seed.js admin <user> <pass>` instead of
       putting credentials here. -->


  <onfailure action="restart" delay="10 sec" />
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
</service>
