# Copy to .env and adjust. Used by docker-compose.

# Public port the dashboard + API listen on.
PULSE_PORT=8080

# Server timezone — the work-hours analytics filter is evaluated in this zone.
TZ=UTC

# First-run bootstrap admin. If PULSE_ADMIN_PASS is empty, no admin is created
# automatically — run `npm run seed` (or docker exec ... node src/seed.js).
PULSE_ADMIN_USER=admin
PULSE_ADMIN_PASS=change-me-please

# Admin session + CSRF token lifetime (minutes). On expiry the dashboard logs out.
PULSE_SESSION_TTL_MIN=60

# Seconds without a heartbeat before a device is shown offline (grey).
PULSE_ONLINE_WINDOW_SEC=120

# Set true when serving over HTTPS (via a reverse proxy) so cookies get Secure.
PULSE_SECURE_COOKIES=false

# The update repo is hardcoded to TMarccci/pulse — only set this if you fork.
# PULSE_REPO=TMarccci/pulse

# Auto-apply new server-v* releases (ignored in Docker; update the image there).
PULSE_AUTO_UPDATE=false
