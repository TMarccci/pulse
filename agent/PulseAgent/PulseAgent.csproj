<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PulseAgent</AssemblyName>
    <RootNamespace>PulseAgent</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Versioning (bumped by the release pipeline from the git tag). -->
    <Version>0.1.0</Version>
    <Company>Pulse</Company>
    <Product>Pulse Agent</Product>

  </PropertyGroup>

  <!-- Single-file, self-contained publish so target PCs need no .NET runtime.
       Applied only for Release/publish so Debug builds stay lean. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

</Project>
